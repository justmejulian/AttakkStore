# Copy to .env and fill in. .env is gitignored; the API's dev script loads it.
# Production sets these with `dokku config:set`, never from a file.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=info@atk-collective.ch
SMTP_PASS=
SMTP_FROM=info@atk-collective.ch
# Fallback only; the admin's Settings screen takes precedence.
NOTIFY_EMAIL=
