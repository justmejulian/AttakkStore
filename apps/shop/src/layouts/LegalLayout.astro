---
/**
 * Shared shell for the legal pages (Impressum, AGB, privacy) — a heading, a
 * last-updated line, and the page's own prose. All three are drafts per the
 * plan doc; someone should read them before launch.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import RichText from "@/components/Typography/RichText.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Page heading, shown as the h1. */
  heading: string;
  /** When the text was last drafted or reviewed, e.g. "September 2026". */
  updated: string;
};

const { heading, updated, ...seo } = Astro.props;
---

<BaseLayout {...seo} theme="light" overlap={true}>
  <Section paddingTop="navoverlap" paddingBottom="large">
    <Heading tag="h1" variant="h2" maxWidth={30}>{heading}</Heading>
    <Eyebrow>Last updated {updated}</Eyebrow>
    <RichText maxWidth={70}>
      <slot />
    </RichText>
  </Section>
</BaseLayout>
