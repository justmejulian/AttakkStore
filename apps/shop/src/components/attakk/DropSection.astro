---
/**
 * DropSection — one collection on the home rail. Everything visual about a drop
 * is data: the theme_base picks the light or dark surface it sits on, and its
 * colours and display font ride in as custom properties (dropThemeStyle), so the
 * masthead, buttons and cards inside all read the drop's palette without a
 * per-drop stylesheet. The intro is a shared DropHeader; the pieces run in a
 * container-query rail that closes with a link to the full collection.
 */
import type { DropWithProducts } from "@attakk/types";
import { dropSwatch, dropThemeStyle } from "@/lib/drop-theme.ts";
import DropHeader from "./DropHeader.astro";
import ProductCard from "./ProductCard.astro";
import ViewAllCard from "./ViewAllCard.astro";

interface Props {
  drop: DropWithProducts;
  /** Set to `false` to skip rendering. */
  render?: boolean;
  class?: string;
}

const { drop, render = true, class: className } = Astro.props;

const style = dropThemeStyle(drop);
const swatch = dropSwatch(drop);

const no = String(drop.no).padStart(2, "0");
const statusLabel = drop.status.charAt(0).toUpperCase() + drop.status.slice(1);
const count = drop.products.length;
---

{
  render && (
    <section
      class:list={["drop", `theme-${drop.theme_base}`, className]}
      style={style}
      data-drop={drop.slug}
    >
      <div class="drop_spine">
        <div class="drop_spine_inner">
          <span>N° {no}</span>
          <span>
            {drop.name} {drop.year}
          </span>
          <span>{statusLabel}</span>
        </div>
      </div>

      <div class="container">
        <div class="drop_grid">
          <DropHeader drop={drop} />

          <div class="drop_products">
            <div class="product-rail">
              {drop.products.map((product, i) => (
                <ProductCard
                  product={product}
                  index={i + 1}
                  count={count}
                  swatch={swatch}
                />
              ))}
              <ViewAllCard drop={drop} />
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  @layer components {
    /* The drop paints itself from the theme its class sets; the inline colour
       overrides ride on top. Not the .section class, so its full-bleed
       background rule does not catch the spine. */
    .drop {
      padding-block: var(--section-space-small);
      background-color: var(--background);
      color: var(--text);
    }

    /* A thin full-bleed rule above each collection, its inner content centred to
       the site width the container uses. */
    .drop_spine {
      padding-block: var(--space-3);
      margin-bottom: var(--space-7);
      background-color: color-mix(in srgb, var(--text) 5%, transparent);
      border-bottom: var(--border-width) solid
        color-mix(in srgb, var(--text) 22%, transparent);
      font-family: var(--label-family);
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .drop_spine_inner {
      width: var(--site-width);
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: flex;
      flex-flow: row wrap;
      justify-content: space-between;
      gap: var(--space-1) var(--space-4);
    }

    /* The two-column collection: a narrow intro beside a wider product area,
       stacking under the drop breakpoint. */
    .drop_grid {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
      gap: var(--space-8);
    }

    @media (width < 64rem) {
      .drop_grid {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-6);
      }
    }

    /* Four across on a wide page; a horizontal scroller when the column is
       narrow, each card snapping into place. */
    .product-rail {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-3);
      align-items: stretch;
    }

    @media (width < 64rem) {
      .product-rail {
        display: flex;
        overflow: auto clip;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: var(--space-3);
        margin-right: calc(var(--site-margin) * -1);
      }
    }
  }
</style>
