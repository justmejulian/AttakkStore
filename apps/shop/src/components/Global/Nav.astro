---
/**
 * Nav — the site header: a link group, the wordmark and the cart control,
 * with a fixed bottom bar taking over on narrow screens. It needs no script:
 * the links are the whole nav, and the current one is marked server-side.
 */
import { SITE_NAME } from "@/consts.ts";
import CartCount from "@/components/attakk/CartCount.tsx";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const links = [
  { href: "/", label: "Shop" },
  { href: "/#drops", label: "Drops" },
  { href: "/club", label: "The Club" },
  { href: "/archive", label: "Archive" },
];

/** Marks the link for the page being viewed. Trailing slashes are ignored. */
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const here = normalize(Astro.url.pathname);
const current = (href: string) =>
  here === normalize(href) ? "page" : undefined;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <nav class="nav_group nav_group-start" aria-label="Primary">
          {links.map((link) => (
            <a
              class="nav_link"
              href={link.href}
              aria-current={current(link.href)}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <a class="nav_brand" href="/" aria-label={SITE_NAME}>
          <span class="nav_wordmark">ATTAKK</span>
          <span class="nav_tagline">Studios · ZRH</span>
        </a>

        <div class="nav_group nav_group-end">
          <span class="nav_lang" aria-hidden="true">
            EN
          </span>
          <a class="nav_link" href="/cart">
            Cart&nbsp;
            <CartCount client:load />
          </a>
        </div>
      </div>
    </header>
  )
}

{
  render && (
    <nav class="nav_mobile theme-invert" aria-label="Primary">
      <a class="nav_link" href="/" aria-current={current("/")}>
        Home
      </a>
      <a class="nav_link" href="/#drops">
        Drops
      </a>
      <a class="nav_link" href="/club" aria-current={current("/club")}>
        Club
      </a>
      <a class="nav_link" href="/cart">
        Cart&nbsp;
        <CartCount client:load />
      </a>
    </nav>
  )
}

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 60;
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: var(--site-width);
      max-width: var(--max-width-main);
      margin-inline: auto;
      min-height: var(--nav-height);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-4);
    }

    .nav_group {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: var(--space-5);
    }

    .nav_group-end {
      justify-content: flex-end;
    }

    .nav_brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      text-decoration: none;
      color: inherit;
    }

    .nav_wordmark {
      font-family: var(--display-family);
      font-weight: var(--primary-bold);
      font-size: 1.75rem;
      line-height: 1;
      letter-spacing: 0.28em;
      /* Centre the tracked wordmark: the last letter's trailing space would
       * otherwise push it left. */
      text-indent: 0.28em;
    }

    .nav_tagline {
      font-family: var(--label-family);
      font-size: 0.5625rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text-2);
    }

    .nav_link {
      position: relative;
      padding-block: var(--space-1);
      font-family: var(--label-family);
      font-size: var(--label);
      letter-spacing: var(--label-letter-spacing);
      text-transform: uppercase;
      text-decoration: none;
      white-space: nowrap;
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);

      &[aria-current="page"]::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: 0.125rem;
        background-color: var(--text);
      }

      @media (hover: hover) {
        &:hover {
          color: var(--heading-accent);
        }
      }
    }

    .nav_lang {
      font-family: var(--label-family);
      font-size: var(--label);
      letter-spacing: var(--label-letter-spacing);
      text-transform: uppercase;
      color: var(--text-2);
    }

    .nav_count {
      color: var(--heading-accent);
      margin-left: 0.25em;
    }

    .nav_mobile {
      display: none;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 80;
      justify-content: space-around;
      align-items: center;
      gap: var(--space-2);
      padding-top: var(--space-3);
      padding-bottom: max(var(--space-3), env(safe-area-inset-bottom));
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--border);
    }

    @media (width < 48rem) {
      .nav_group-start {
        display: none;
      }

      .nav_inner {
        grid-template-columns: auto 1fr auto;
      }

      .nav_mobile {
        display: flex;
      }
    }
  }
</style>
