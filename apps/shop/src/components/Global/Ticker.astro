---
/**
 * Ticker — a strip of short announcements on an inverted surface, sitting above
 * the nav. The band and its motion are the shared `MarqueeStrip`; this
 * component is only the announcements it carries. They are chrome, not content,
 * so they live here rather than travelling as a prop; a later step wires the
 * current drop's status in.
 */
import MarqueeStrip from "@/components/attakk/MarqueeStrip.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

const announcements = [
  "Free shipping over 150 CHF",
  "Built in Zürich",
  "No restocks",
];
---

<MarqueeStrip items={announcements} label="Announcements" render={render} />
