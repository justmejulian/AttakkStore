---
/**
 * Ticker — a strip of short announcements on an inverted surface, sitting
 * above the nav. The scrolling is the shared `Marquee`; this component is the
 * announcements and the chrome styling around them. The items are chrome, not
 * content, so they live here rather than travelling as a prop; a later step
 * wires the current drop's status in.
 */
import Marquee from "@/components/Interactive/Marquee.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

const items = [
  "Free shipping over 150 CHF",
  "Built in Zürich",
  "Friends + family only",
  "No restocks",
];
---

{
  render && (
    <Marquee class="ticker_wrap theme-invert" label="Announcements">
      {items.map((item) => (
        <span class="ticker_item">
          {item}
          <span class="ticker_dot" aria-hidden="true">
            ●
          </span>
        </span>
      ))}
    </Marquee>
  )
}

<style is:global>
  @layer components {
    .ticker_wrap {
      padding-block: var(--space-2);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--text);
    }

    /* Two classes so the pace override wins over Marquee's own --_speed
     * regardless of stylesheet order — a calmer chrome ticker, not a race. */
    .ticker_wrap.marquee_wrap {
      --_speed: 9s;
    }

    .ticker_item {
      display: inline-flex;
      align-items: center;
      gap: var(--space-4);
      font-family: var(--label-family);
      font-size: var(--label);
      font-weight: var(--primary-medium);
      letter-spacing: var(--label-letter-spacing);
      text-transform: uppercase;
    }

    .ticker_dot {
      color: var(--heading-accent);
    }
  }
</style>
