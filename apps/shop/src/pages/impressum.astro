---
/**
 * /impressum — the legal notice a Swiss online provider must publish (UWG
 * art. 3 lit. s). Every bracketed value is a placeholder inherited from the
 * same defaults as the QR-bill creditor (see apps/api/src/creditor.ts) or
 * marked [like this] where no placeholder exists yet — swap them for the
 * real details, and have someone read the page, before launch.
 */
import LegalLayout from "@/layouts/LegalLayout.astro";
---

<LegalLayout
  title="Impressum"
  description="Legal notice for atk-collective.ch: who operates this site and how to reach us."
  heading="Impressum"
  updated="September 2026"
>
