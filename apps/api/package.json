{
  "name": "@attakk/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed-user": "tsx --conditions=source src/cli/seed-user.ts",
    "check": "tsc --noEmit",
    "test": "tsx --conditions=source --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@attakk/types": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "swissqrbill": "^4.4.1"
  },
  "devDependencies": {
    "@attakk/mocks": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
